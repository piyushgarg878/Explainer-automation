# --- Secrets (never commit the real .env) ---
OPENROUTER_API_KEY=
N8N_ENCRYPTION_KEY=change-me

# --- Models (discover valid slugs via GET /api/v1/videos/models) ---
TEXT_MODEL=
VIDEO_MODEL_PRIMARY=
VIDEO_MODEL_FALLBACK=

# --- Video ---
FORMAT=short                 # short | long
VIDEO_RESOLUTION=720p
ASPECT_RATIO=9:16
SCENE_SECONDS=5
MAX_SCENES=12
GENERATE_AUDIO=false
PARALLEL_SCENES=3

# --- Channel / publishing ---
CHANNEL_NICHE=health and human body explainers (how the body works, what happens when you eat/do X)
PRIVACY_STATUS=private       # flip to public only after owner approval
PUBLISH_TZ=Asia/Kolkata
SCHEDULE_CRON=0 9 * * *

# --- Safety / cost ---
MAX_COST_PER_VIDEO_USD=
LIVE=false                   # must be true to spend money on video/TTS APIs

# --- TTS (decision pending: openrouter | elevenlabs | openai | piper) ---
TTS_PROVIDER=piper

# --- Notifications (decision pending) ---
NOTIFY_CHANNEL=
